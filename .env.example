# Copy to .env. This is parsed as key=value text; shell commands are never executed.
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
SHOP_NAME=示例卡密服务
PAYMENT_QR_FILE=assets/demo-qr.svg
ADMIN_PASSWORD=demo-only-change-me
UPSTREAM_MODE=mock
UPSTREAM_SCRIPT=adapters/mock_adapter.py
ALLOW_LIVE_UPSTREAM=false
# Optional isolated local data directory. Default: data/ beside server.py.
# DEMO_DATA_DIR=/absolute/path/to/private-data
# Real custom mode requires a new administrator password and explicit opt-in.
# UPSTREAM_MODE=custom
# UPSTREAM_SCRIPT=adapters/custom_adapter.py
# ALLOW_LIVE_UPSTREAM=true
